import Foundation

// Template for AppSecrets.swift, which is gitignored (holds real OAuth client secrets) and
// therefore never checked in. The Xcode project auto-compiles every Swift file physically present
// under Yomi/ (PBXFileSystemSynchronizedRootGroup) — without a real AppSecrets.swift, the build
// fails with "cannot find AppSecrets in scope" wherever a tracker service references it.
//
// To build after a fresh clone: copy this file to AppSecrets.swift (same directory, note the
// .swift extension — NOT .swift.template) and fill in the values you need. MAL is required for
// the MyAnimeList tracker to compile at all; the other three trackers compile with empty strings,
// they just won't be able to authenticate until filled in. Registration steps for each are linked
// below. Keep this file's own extension as .swift.template, never .swift — the synchronized-group
// Xcode project auto-compiles every .swift file it finds, so a second real AppSecrets.swift here
// would collide with the gitignored one and fail the build with a duplicate-declaration error.

enum AppSecrets {
    /// Register at https://myanimelist.net/apiconfig — redirect URL: yomi://mal/callback
    static let malClientId = ""

    /// Register at https://anilist.co/settings/developer — redirect URL: yomi://anilist/callback
    static let aniListClientId = ""

    /// Register at https://shikimori.io/oauth/applications — redirect URL: yomi://shikimori/callback
    static let shikimoriClientId = ""
    static let shikimoriClientSecret = ""

    /// Register at https://bgm.tv/dev/app — redirect URL: yomi://bangumi/callback
    static let bangumiClientId = ""
    static let bangumiClientSecret = ""
}
