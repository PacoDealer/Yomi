        }
      }
    },
    "Tap a chapter to retry it. Pages that already downloaded are kept.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un capítulo para reintentarlo. Las páginas ya descargadas se conservan."
