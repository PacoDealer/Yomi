      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una copia de Yomi, un .tachibk de Mihon o Tachiyomi, o un .tmb de Tachimanga: tu biblioteca, tus categorías y tu progreso de lectura vienen incluidos."
