{
  "sourceLanguage": "en",
  "strings": {
    "NSFaceIDUsageDescription": {
      "comment": "Info.plist permission prompt",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Yomi uses Face ID to unlock when App Lock is on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Yomi usa Face ID para desbloquearse cuando el bloqueo de la app está activado."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "comment": "Info.plist permission prompt",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Saves a reader page you choose to Photos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda en Fotos una página del lector que elijas."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "comment": "Info.plist permission prompt",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Used to set custom cover images for manga and novels."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa para poner portadas personalizadas a mangas y novelas."
          }
        }
      }
    }
  },
  "version": "1.0"
