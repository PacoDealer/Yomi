// TestFlight / App Store build: Yomi signed by Martin's PAID Apple Developer Program team (enrolled 2026-10-11).
// Unlike Personal.xcconfig this keeps the project's real entitlements (CloudKit, push, App Group — the paid team
// can sign them) and does not define YOMI_PERSONAL. It only adds the team and the on-device Keiyoushi runtime.
// Usage: scripts/build-testflight.sh   (passes this file with -xcconfig, overriding every target)
// Same Team ID as the old free Personal Team: Apple upgraded it in place when Martin enrolled (S151).
DEVELOPMENT_TEAM = F9R33MN82P
CODE_SIGN_STYLE = Automatic

// On-device Keiyoushi (S124): see Personal.xcconfig.
YOMI_EMBED_KEIYOUSHI = YES
ENABLE_USER_SCRIPT_SANDBOXING = NO
