diff --git a/server/src/main/kotlin/eu/kanade/tachiyomi/network/interceptor/NoZstdInterceptor.kt b/server/src/main/kotlin/eu/kanade/tachiyomi/network/interceptor/NoZstdInterceptor.kt
new file mode 100644
index 0000000..204cd1d
--- /dev/null
+++ b/server/src/main/kotlin/eu/kanade/tachiyomi/network/interceptor/NoZstdInterceptor.kt
@@ -0,0 +1,27 @@
+package eu.kanade.tachiyomi.network.interceptor
+
+import okhttp3.Interceptor
+import okhttp3.Response
+
+/**
+ * Yomi patch: Keiyoushi's KeiSource adds `CompressionInterceptor(Brotli, Gzip, Zstd)`, which advertises
+ * zstd. okhttp-zstd decodes through a JNI library that cannot load on iOS (and has no macOS build in
+ * this jar), so any zstd response crashes the call. Registered as a network interceptor, this runs after
+ * every application interceptor and drops zstd from Accept-Encoding; servers fall back to br/gzip,
+ * which decode in pure Java.
+ */
