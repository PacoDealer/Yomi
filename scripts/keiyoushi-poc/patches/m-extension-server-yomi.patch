+package eu.kanade.tachiyomi.network.interceptor
+
+import okhttp3.Interceptor
+import okhttp3.Response
+import okhttp3.ResponseBody
+import okhttp3.ResponseBody.Companion.asResponseBody
+import okio.Buffer
+import okio.ForwardingSource
+import okio.buffer
+
+/**
+ * Yomi diagnostic (S134): logs, per network request, protocol, TLS cipher, bytes received on the wire
+ * (before decompression) and time to the last byte. Enabled with
+ * -Dyomi.wireStats=true; prints "YOMI-WIRE ..." lines to stderr.
+ */
+class WireStatsInterceptor : Interceptor {
+    override fun intercept(chain: Interceptor.Chain): Response {
+        val request = chain.request()
+        val start = System.nanoTime()
+        val response = chain.proceed(request)
+        val headersMs = (System.nanoTime() - start) / 1_000_000
+        val body = response.body
+        val handshake = response.handshake
+        val tag =
+            "${request.method} ${request.url.host}${request.url.encodedPath} ${response.protocol} " +
+                "${handshake?.tlsVersion?.javaName ?: "-"} ${handshake?.cipherSuite?.javaName ?: "-"} " +
+                "status=${response.code} enc=${response.header("Content-Encoding") ?: "-"} headersMs=$headersMs"
+        val counting =
+            object : ForwardingSource(body.source()) {
+                var bytes = 0L
+                var done = false
+
+                override fun read(
+                    sink: Buffer,
+                    byteCount: Long,
+                ): Long {
+                    val n = super.read(sink, byteCount)
+                    if (n > 0) bytes += n else report()
+                    return n
+                }
+
+                override fun close() {
+                    report()
+                    super.close()
+                }
+
+                fun report() {
+                    if (done) return
+                    done = true
+                    System.err.println(
+                        "YOMI-WIRE $tag wireBytes=$bytes totalMs=${(System.nanoTime() - start) / 1_000_000}",
+                    )
+                }
+            }
+        val wrapped: ResponseBody = counting.buffer().asResponseBody(body.contentType(), body.contentLength())
+        return response.newBuilder().body(wrapped).build()
+    }
+}
