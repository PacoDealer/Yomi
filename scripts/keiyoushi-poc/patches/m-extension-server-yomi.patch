diff --git a/server/src/main/java/com/googlecode/dex2jar/ir/ts/NewTransformer.java b/server/src/main/java/com/googlecode/dex2jar/ir/ts/NewTransformer.java
new file mode 100644
index 0000000..b4148c0
--- /dev/null
+++ b/server/src/main/java/com/googlecode/dex2jar/ir/ts/NewTransformer.java
@@ -0,0 +1,405 @@
+// Yomi patch (S208), copied from dex2jar 2.4.33 (Apache-2.0, ThexXTURBOXx/dex2jar) and shadowing that class in the
+// server jar. Newer R8 drops trivial constructors and emits `new-instance Lr;` + `invoke-direct Object.<init>()`.
+// Upstream merged the pair into `new Object()` (the invoke's owner), which the JVM verifier rejects when the value is
+// stored as `r` ("Bad type on operand stack"). We keep the new-instance type; PackageTools.fixDex2jarOutput then
+// gives `r` the pass-through constructor the JVM needs. Only the two nInvokeNew calls below differ from upstream.
+package com.googlecode.dex2jar.ir.ts;
+
+import com.googlecode.dex2jar.ir.ET;
+import com.googlecode.dex2jar.ir.IrMethod;
+import com.googlecode.dex2jar.ir.StmtTraveler;
+import com.googlecode.dex2jar.ir.expr.Exprs;
+import com.googlecode.dex2jar.ir.expr.InvokeExpr;
+import com.googlecode.dex2jar.ir.expr.Local;
+import com.googlecode.dex2jar.ir.expr.NewExpr;
+import com.googlecode.dex2jar.ir.expr.Value;
+import com.googlecode.dex2jar.ir.stmt.AssignStmt;
+import com.googlecode.dex2jar.ir.stmt.LabelStmt;
+import com.googlecode.dex2jar.ir.stmt.Stmt;
+import com.googlecode.dex2jar.ir.stmt.Stmts;
+import java.util.Arrays;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.Iterator;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+import static com.googlecode.dex2jar.ir.expr.Value.VT.INVOKE_SPECIAL;
+import static com.googlecode.dex2jar.ir.expr.Value.VT.LOCAL;
+import static com.googlecode.dex2jar.ir.expr.Value.VT.NEW;
+import static com.googlecode.dex2jar.ir.stmt.Stmt.ST.ASSIGN;
+import static com.googlecode.dex2jar.ir.stmt.Stmt.ST.LABEL;
+import static com.googlecode.dex2jar.ir.stmt.Stmt.ST.VOID_INVOKE;
+
+/**
+ * simply merge
+ * <p>
+ * <pre>
+ *     a=NEW Labc;
+ *     a.&lt;init&gt;();
+ * </pre>
+ * <p>
+ * to
+ * <p>
+ * <pre>
+ * a = new abc();
+ * </pre>
+ * <p>
+ * Run after [SSATransformer, RemoveLocalFromSSA]
+ */
+public class NewTransformer implements Transformer {
+
+    static final Vx IGNORED = new Vx(null, true);
+
+    @Override
+    public void transform(IrMethod method) {
+
+        // 1. replace
+        // =========
+        // a=NEW Abc;
+        // b=a
+        // b.<init>()
+        // to ======
+        // a=new Abc();
+        // b=a;
+        // =========
+        replaceX(method);
+
+        // 2. replace NEW Abc;.<init>() -> new Abc();
+        replaceAST(method);
+
+    }
+
+    void replaceX(IrMethod method) {
+        final Map<Local, TObject> init = new HashMap<>();
+        for (Stmt p : method.stmts) {
+            if (p.st == ASSIGN && p.getOp1().vt == LOCAL && p.getOp2().vt == NEW) {
+                // the stmt is a new assign stmt
+                Local local = (Local) p.getOp1();
+                init.put(local, new TObject(local, (AssignStmt) p));
+            }
+        }
+
+        if (!init.isEmpty()) {
+            final int size = Cfg.reIndexLocal(method);
+            makeSureUsedBeforeConstructor(method, init, size);
+            if (!init.isEmpty()) {
+                replace0(method, init, size);
+            }
+            for (Stmt stmt : method.stmts) {
+                stmt.frame = null;
+            }
+        }
+    }
+
+    void replaceAST(IrMethod method) {
+        Iterator<Stmt> it = method.stmts.iterator();
+        while (it.hasNext()) {
+            Stmt p = it.next();
+
+            InvokeExpr ie = findInvokeExpr(p);
+
+            if (ie != null) {
+                if ("<init>".equals(ie.getName()) && "V".equals(ie.getRet())) {
+                    Value[] orgOps = ie.getOps();
+                    if (orgOps[0].vt == NEW) {
+                        NewExpr newExpr = (NewExpr) ie.getOps()[0];
+                        if (newExpr != null) {
+                            Value[] nOps = Arrays.copyOfRange(orgOps, 1, orgOps.length);
+                            InvokeExpr invokeNew = Exprs.nInvokeNew(nOps, ie.getArgs(), newExpr.type);
+                            method.stmts.insertBefore(p, Stmts.nVoidInvoke(invokeNew));
+                            it.remove();
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    void replace0(IrMethod method, Map<Local, TObject> init, int size) {
+        Set<Local> toDelete = new HashSet<>();
+
+        Local[] locals = new Local[size];
+        for (Local local : method.locals) {
+            locals[local.lsIndex] = local;
+        }
+
+        // find all locals to delete
+        for (TObject obj : init.values()) {
+            Vx[] frame = (Vx[]) obj.invokeStmt.frame;
+            for (int i = 0; i < frame.length; i++) {
+                Vx s = frame[i];
+                if (s != null && s.obj == obj) {
+                    toDelete.add(locals[i]);
+                }
+            }
+        }
+        // delete the locals
+        Iterator<Stmt> it = method.stmts.iterator();
+        while (it.hasNext()) {
+            Stmt p = it.next();
+            if (p.st == ASSIGN && p.getOp1().vt == LOCAL) {
+                if (toDelete.contains((Local) p.getOp1())) {
+                    it.remove();
+                }
+            }
+        }
+        // add the locals back
+        for (TObject obj : init.values()) {
+            Vx[] frame = (Vx[]) obj.invokeStmt.frame;
+            for (int i = 0; i < frame.length; i++) {
+                Vx s = frame[i];
+                if (s != null && s.obj == obj) {
+                    Local b = locals[i];
+                    if (b != obj.local) {
+                        method.stmts.insertAfter(obj.invokeStmt, Stmts.nAssign(b, obj.local));
+                    }
+                }
+            }
+            InvokeExpr ie = findInvokeExpr(obj.invokeStmt);
+            Value[] orgOps = ie.getOps();
+            Value[] nOps = Arrays.copyOfRange(orgOps, 1, orgOps.length);
+            InvokeExpr invokeNew = Exprs.nInvokeNew(nOps, ie.getArgs(), ((NewExpr) obj.init.getOp2()).type);
+            method.stmts.replace(obj.invokeStmt, Stmts.nAssign(obj.local, invokeNew));
+        }
+    }
+
+    void makeSureUsedBeforeConstructor(IrMethod method, final Map<Local, TObject> init, final int size) {
+        Cfg.createCFG(method);
+        Cfg.dfs(method.stmts, new Cfg.FrameVisitor<Vx[]>() {
+
+            boolean keepFrame = false;
+            final Vx[] tmp = new Vx[size];
+            final StmtTraveler stmtTraveler = new StmtTraveler() {
+                Stmt current;
+
+                @Override
+                public Stmt travel(Stmt stmt) {
+
+                    this.current = stmt;
+                    if (stmt.et == ET.E2) {
+                        if (stmt.getOp1().vt == LOCAL) {
+                            Local op1 = (Local) stmt.getOp1();
+                            if (stmt.getOp2().vt == LOCAL) {
+                                Local op2 = (Local) stmt.getOp2();
+                                tmp[op1.lsIndex] = tmp[op2.lsIndex];
+                                return stmt;
+                            } else if (stmt.getOp2().vt == NEW) {
+                                tmp[op1.lsIndex] = new Vx(init.get(op1), false);
+                                return stmt;
+                            } else {
+                                travel(stmt.getOp2());
+                                tmp[op1.lsIndex] = IGNORED;
+                                return stmt;
+                            }
+                        }
+                    }
+                    if (stmt.st == LABEL) {
+                        LabelStmt labelStmt = (LabelStmt) stmt;
+                        if (labelStmt.phis != null) {
+                            for (AssignStmt phi : labelStmt.phis) {
+                                Local local = (Local) phi.getOp1();
+                                tmp[local.lsIndex] = IGNORED;
+                            }
+                        }
+                        return stmt;
+                    }
+                    return super.travel(stmt);
+                }
+
+                @Override
+                public Value travel(Value op) {
+                    if (op.vt == INVOKE_SPECIAL) {
+                        if (op.getOps().length >= 1) {
+                            InvokeExpr ie = (InvokeExpr) op;
+                            if ("<init>".equals(ie.getName())) {
+                                Value thiz = op.getOps()[0];
+                                if (thiz.vt == LOCAL) {
+                                    Local local = (Local) thiz;
+                                    Vx vx = tmp[local.lsIndex];
+                                    TObject object = vx.obj;
+                                    if (object != null) {
+                                        if (object.invokeStmt != null) {
+                                            object.useBeforeInit = true;
+                                        } else {
+                                            vx.init = true;
+                                            object.invokeStmt = current;
+                                            for (int i = 0; i < tmp.length; i++) {
+                                                Vx s = tmp[i];
+                                                if (s != null && s.obj == object) {
+                                                    tmp[i] = IGNORED;
+                                                }
+                                            }
+                                            keepFrame = true;
+                                        }
+                                    }
+                                }
+                            }
+                        }
+                    }
+                    op = super.travel(op);
+
+                    if (op.vt == LOCAL) {
+                        use((Local) op);
+                    }
+
+                    return op;
+                }
+            };
+
+            @Override
+            public Vx[] merge(Vx[] srcFrame, Vx[] distFrame, Stmt src, Stmt dist) {
+                if (distFrame == null) {
+                    distFrame = new Vx[size];
+                    System.arraycopy(srcFrame, 0, distFrame, 0, size);
+                } else {
+                    for (int i = 0; i < size; i++) {
+                        Vx s = srcFrame[i];
+                        Vx d = distFrame[i];
+                        if (s != null) {
+                            if (d == null) {
+                                distFrame[i] = s;
+                            } else {
+                                if (s != d) {
+                                    TObject obj = s.obj;
+                                    if (obj != null) {
+                                        obj.useBeforeInit = true;
+                                    }
+                                    obj = d.obj;
+                                    if (obj != null) {
+                                        obj.useBeforeInit = true;
+                                    }
+                                }
+                            }
+                        }
+                    }
+                }
+
+                if (dist.st == LABEL) {
+                    List<AssignStmt> phis = ((LabelStmt) dist).phis;
+                    if (phis != null && !phis.isEmpty()) {
+                        for (AssignStmt phi : phis) {
+                            for (Value value : phi.getOp2().getOps()) {
+                                Local local = (Local) value;
+                                int i = local.lsIndex;
+                                Vx s = srcFrame[i];
+                                Vx d = distFrame[i];
+                                if (d != null) {
+                                    if (!d.init) {
+                                        TObject obj = d.obj;
+                                        if (obj != null) {
+                                            obj.useBeforeInit = true;
+                                        }
+                                    }
+                                } else if (s != null) {
+                                    if (!s.init) {
+                                        TObject obj = s.obj;
+                                        if (obj != null) {
+                                            obj.useBeforeInit = true;
+                                        }
+                                    }
+                                }
+                            }
+                        }
+                    }
+                }
+                return distFrame;
+            }
+
+            @Override
+            public Vx[] initFirstFrame(Stmt first) {
+                return new Vx[size];
+            }
+
+            @Override
+            public Vx[] exec(Vx[] frame, Stmt stmt) {
+                keepFrame = false;
+                System.arraycopy(frame, 0, tmp, 0, size);
+                stmtTraveler.travel(stmt);
+                if (stmt.cfgFroms.size() > 1) {
+                    keepFrame = true;
+                }
+
+                if (!keepFrame) {
+                    stmt.frame = null;
+                }
+                return tmp;
+            }
+
+            void use(Local local) {
+                Vx vx = tmp[local.lsIndex];
+                if (!vx.init) {
+                    TObject object = vx.obj;
+                    if (object != null) {
+                        object.useBeforeInit = true;
+                    }
+
+                    tmp[local.lsIndex] = IGNORED;
+                }
+
+            }
+        });
+        Iterator<Map.Entry<Local, TObject>> iterator = init.entrySet().iterator();
+        while (iterator.hasNext()) {
+            Map.Entry<Local, TObject> e = iterator.next();
+            boolean keep = true;
+            TObject obj = e.getValue();
+            if (obj.useBeforeInit) {
+                keep = false;
+            }
+            if (obj.invokeStmt == null) {
+                keep = false;
+            }
+            if (!keep) {
+                iterator.remove();
+            }
+        }
+    }
+
+    InvokeExpr findInvokeExpr(Stmt p) {
+        InvokeExpr ie = null;
+        if (p.st == ASSIGN) {
+            if (p.getOp2().vt == INVOKE_SPECIAL) {
+                ie = (InvokeExpr) p.getOp2();
+            }
+        } else if (p.st == VOID_INVOKE) {
+            Value op = p.getOp();
+            if (op instanceof InvokeExpr) {
+                ie = (InvokeExpr) op;
+            }
+        }
+        return ie;
+    }
+
+    static class TObject {
+
+        public Stmt invokeStmt;
+
+        Local local;
+
+        boolean useBeforeInit;
+
+        private final AssignStmt init;
+
+        TObject(Local local, AssignStmt init) {
+            this.local = local;
+            this.init = init;
+        }
+
+    }
+
+    static class Vx {
+
+        boolean init;
+
+        TObject obj;
+
+        Vx(TObject obj, boolean init) {
+            this.obj = obj;
+            this.init = init;
+        }
+
+    }
+
+}
diff --git a/server/src/main/kotlin/com/squareup/zstd/okio/OkioZstd.kt b/server/src/main/kotlin/com/squareup/zstd/okio/OkioZstd.kt
new file mode 100644
index 0000000..7ae6200
--- /dev/null
+++ b/server/src/main/kotlin/com/squareup/zstd/okio/OkioZstd.kt
@@ -0,0 +1,132 @@
+@file:JvmName("OkioZstd")
+
+package com.squareup.zstd.okio
+
+import okio.Buffer
+import okio.ForwardingSource
+import okio.IOException
+import okio.Sink
+import okio.Source
+import okio.Timeout
+import okio.buffer
+
+/*
+ * Yomi patch (MPL-2.0, like the rest of this server): a pure-JVM stand-in for zstd-kmp-okio's `OkioZstd`.
+ *
+ * The real one compresses through `JniZstd`, whose native library does not exist in the iOS runtime (nor in this
+ * java.base-only jar on a Mac), so Keiyoushi's `KeiSource` filter cache (`zstdCompress()` / `zstdDecompress()`)
+ * died with NoClassDefFoundError and site-fetched filters (Asura's Genres, Author/Artist) never loaded — Yomi
+ * KNOWN_ISSUES #207. The shadow jar leaves the real module out (server/build.gradle.kts, iOS mode).
+ *
+ * Same JVM signatures. Writing produces a valid zstd frame (RFC 8878) made only of Raw blocks: uncompressed, but
+ * every zstd reader accepts it. Reading accepts Raw and RLE blocks — enough for anything written here — and fails
+ * with an IOException on a Compressed block, which callers already treat as "no cache". okhttp-zstd also calls
+ * `zstdDecompress`, but Yomi's NoZstdInterceptor keeps zstd out of Accept-Encoding, so no server sends it.
+ * Data is buffered whole: the only users are small JSON caches.
+ */
+
+private const val MAGIC = 0xFD2FB528.toInt()
+private const val BLOCK = 64 * 1024 // Block_Maximum_Size must stay <= the window (128 KiB below)
+
+fun Sink.zstdCompress(): Sink = RawZstdSink(this)
+
+fun Source.zstdDecompress(): Source = RawZstdSource(this)
+
+private class RawZstdSink(
+    private val sink: Sink,
+) : Sink {
+    private val pending = Buffer()
+    private var closed = false
+
+    override fun write(
+        source: Buffer,
+        byteCount: Long,
+    ) {
+        check(!closed) { "closed" }
+        pending.write(source, byteCount)
+    }
+
+    override fun flush() = Unit // a frame is only complete at close()
+
+    override fun timeout(): Timeout = sink.timeout()
+
+    override fun close() {
+        if (closed) return
+        closed = true
+        val out = Buffer()
+        out.writeIntLe(MAGIC)
+        out.writeByte(0x00) // descriptor: no content size, not single-segment, no checksum, no dictionary
+        out.writeByte(7 shl 3) // window descriptor: 2^(10+7) = 128 KiB
+        do {
+            val size = minOf(pending.size, BLOCK.toLong()).toInt()
+            val last = pending.size == size.toLong()
+            val header = (size shl 3) or (if (last) 1 else 0) // Block_Type 0 = Raw
+            out.writeByte(header and 0xFF)
+            out.writeByte((header ushr 8) and 0xFF)
+            out.writeByte((header ushr 16) and 0xFF)
+            out.write(pending, size.toLong())
+        } while (!last)
+        sink.use {
+            it.write(out, out.size)
+            it.flush()
+        }
+    }
+}
+
+private class RawZstdSource(
+    source: Source,
+) : ForwardingSource(source) {
+    private var decoded: Buffer? = null
+
+    override fun read(
+        sink: Buffer,
+        byteCount: Long,
+    ): Long {
+        val buffer = decoded ?: decodeAll().also { decoded = it }
+        return buffer.read(sink, byteCount)
+    }
+
+    private fun decodeAll(): Buffer {
+        val input = delegate.buffer()
+        val out = Buffer()
+        while (!input.exhausted()) {
+            val magic = input.readIntLe()
+            if ((magic and 0xFFFFFFF0.toInt()) == 0x184D2A50) { // skippable frame
+                input.skip(input.readIntLe().toLong() and 0xFFFFFFFFL)
+                continue
+            }
+            if (magic != MAGIC) throw IOException("not a zstd frame")
+            val descriptor = input.readByte().toInt() and 0xFF
+            val singleSegment = descriptor and 0x20 != 0
+            if (!singleSegment) input.skip(1) // window descriptor
+            input.skip(intArrayOf(0, 1, 2, 4)[descriptor and 0x03].toLong()) // dictionary id
+            val fcsFlag = descriptor ushr 6
+            input.skip(
+                when (fcsFlag) {
+                    0 -> if (singleSegment) 1L else 0L
+                    1 -> 2L
+                    2 -> 4L
+                    else -> 8L
+                },
+            )
+            do {
+                val b0 = input.readByte().toInt() and 0xFF
+                val b1 = input.readByte().toInt() and 0xFF
+                val b2 = input.readByte().toInt() and 0xFF
+                val header = b0 or (b1 shl 8) or (b2 shl 16)
+                val last = header and 1 != 0
+                val size = (header ushr 3).toLong()
+                when ((header ushr 1) and 0x03) {
+                    0 -> input.readFully(out, size)
+                    1 -> {
+                        val byte = input.readByte()
+                        repeat(size.toInt()) { out.writeByte(byte.toInt()) }
+                    }
+                    else -> throw IOException("compressed zstd blocks are not supported by Yomi's stand-in")
+                }
+            } while (!last)
+            if (descriptor and 0x04 != 0) input.skip(4) // content checksum
+        }
+        return out
+    }
+}
